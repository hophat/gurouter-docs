---
/**
 * LiveInstead — a dead end still needs an exit. These links point at pages that work today.
 */
interface Props {
	links: { href: string; title: string; body: string }[];
}

const { links } = Astro.props;
---

<nav class="live" aria-label="Live documentation">
	{
		links.map((link) => (
			<a class="live-item" href={link.href}>
				<span class="live-title">{link.title}</span>
				<span class="live-body">{link.body}</span>
			</a>
		))
	}
</nav>

<style>
	.live {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin-block-start: var(--gr-space-6);
		border-top: 1px solid var(--gr-border);
	}
	@media (min-width: 46rem) {
		.live {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.live-item {
		display: grid;
		align-content: start;
		gap: 0.2rem;
		min-height: 3.5rem;
		padding: 1rem 1rem 1rem 0;
		border-bottom: 1px solid var(--gr-border);
		text-decoration: none;
		transition:
			background-color var(--gr-dur) var(--gr-ease),
			padding-inline-start var(--gr-dur) var(--gr-ease);
	}
	@media (min-width: 46rem) {
		.live-item + .live-item {
			padding-inline-start: 1rem;
			border-inline-start: 1px solid var(--gr-border);
		}
	}

	/* Hover indents the row instead of lifting it: this is a list, not a card. */
	.live-item:hover {
		background: var(--gr-surface-2);
	}
	.live-item:hover .live-title {
		color: var(--gr-accent-text);
	}
	.live-item:focus-visible {
		outline: 2px solid var(--gr-focus);
		outline-offset: -2px;
		border-radius: var(--gr-radius-sm);
	}

	.live-title {
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--gr-text-1);
		transition: color var(--gr-dur-fast) var(--gr-ease);
	}
	.live-body {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--gr-text-3);
	}
</style>
