---
import { Icon } from '@astrojs/starlight/components';
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
---

<footer class="sl-footer gr-footer">
	<nav class="gr-footer-nav" aria-label="Documentation sections">
		<a class="gr-footer-link" href="/getting-started/agents/">
			<Icon name="rocket" size="1.1em" />
			<span>
				<strong>Agent setup</strong>
				<small>Base URL, auth, chat</small>
			</span>
		</a>
		<a class="gr-footer-link" href="/api/openai-compat/">
			<Icon name="seti:http" size="1.1em" />
			<span>
				<strong>API reference</strong>
				<small>OpenAI-compatible routes</small>
			</span>
		</a>
		<a class="gr-footer-link" href="/api/systemone/">
			<Icon name="setting" size="1.1em" />
			<span>
				<strong>SystemOne</strong>
				<small>Structured decisions</small>
			</span>
		</a>
		<a class="gr-footer-link" href="/getting-started/cli-setup/">
			<Icon name="list-format" size="1.1em" />
			<span>
				<strong>CLI tools</strong>
				<small>Claude Code, Codex, Gemini</small>
			</span>
		</a>
	</nav>

	<div class="gr-footer-base">
		<p class="gr-footer-note">
			Routes documented here were verified against the live gateway. Anything not listed is
			not guaranteed to exist.
		</p>
		{/* Overriding Footer replaces Starlight's, which is where these two live. They
		    have to be re-mounted here or the page silently loses them. */}
		<div class="gr-footer-meta-row">
			<div class="gr-footer-meta sl-flex">
				<EditLink />
				<LastUpdated />
			</div>
			<p class="gr-footer-meta">
				<a href="https://gurouter.com" rel="noreferrer noopener">gurouter.com</a>
				<span aria-hidden="true">·</span>
				<a href="https://github.com/hophat/gurouter-docs" rel="noreferrer noopener">Source</a>
			</p>
		</div>
	</div>
</footer>

<script>
	import '../scripts/table-scroll';
</script>

<style>
	.gr-footer {
		display: grid;
		gap: 1.5rem;
	}

	/* Flat section list instead of a nested card grid — a link is not a card. */
	.gr-footer-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		border-top: 1px solid var(--gr-border);
	}
	@media (min-width: 46rem) {
		.gr-footer-nav {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.gr-footer-link {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		min-height: 3.25rem;
		padding: 0.9rem 0.75rem;
		border-bottom: 1px solid var(--gr-border);
		color: var(--gr-text-2);
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.gr-footer-link:hover {
		background: var(--gr-surface-2);
		color: var(--gr-text-1);
	}
	.gr-footer-link:focus-visible {
		outline: 2px solid var(--gr-focus);
		outline-offset: -2px;
		border-radius: var(--gr-radius-sm);
	}
	.gr-footer-link :global(svg) {
		margin-top: 0.15em;
		color: var(--gr-text-3);
	}
	.gr-footer-link:hover :global(svg) {
		color: var(--gr-accent-text);
	}
	.gr-footer-link span {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
	}
	.gr-footer-link strong {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.gr-footer-link small {
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--gr-text-3);
	}

	.gr-footer-base {
		display: grid;
		gap: 0.5rem;
	}
	.gr-footer-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	/* Starlight styles these two itself; only the size and colour need matching here. */
	.gr-footer-meta-row :global(.sl-meta) {
		font-size: 0.75rem;
		color: var(--gr-text-4);
	}
	.gr-footer-note {
		margin: 0;
		max-width: 62ch;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--gr-text-3);
	}
	.gr-footer-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--gr-mono);
		font-size: 0.75rem;
		color: var(--gr-text-4);
	}
	.gr-footer-meta a {
		color: inherit;
		text-decoration: none;
	}
	.gr-footer-meta a:hover {
		color: var(--gr-text-2);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
